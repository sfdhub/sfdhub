
Library ieee;
use ieee.std_logic_1164.all;

entity alu_op01 is
port(
	X,Y  : in Std_Logic_Vector(40 downto 0);
	Z11out  : out Std_Logic_Vector(40 downto 0)     
);
end alu_op01;

Architecture ALU of alu_op01 is
  constant const0 :std_Logic_Vector(40 downto 0) := (others => '0');
  
BEGIN
	P <= X or Y;
    Z11out <= not P;
    
END;