
Library ieee;
use ieee.std_logic_1164.all;

entity alu_op00 is
port(
	X,Y  : in Std_Logic_Vector(40 downto 0);
	Pout : in Std_Logic_Vector(40 downto 0);
	Zout  : out Std_Logic_Vector(40 downto 0)     
);
end alu_op00;

Architecture ALU of alu_op00 is
  constant const0 :std_Logic_Vector(40 downto 0) := (others => '0');
  signal P: std_Logic_Vector(40 downto 0);

BEGIN
	Pout <= P;
    P <= X xor Y;
    Zout <= not P;
    
END;


